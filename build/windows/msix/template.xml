<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hyperv-vmmanager.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Local\Hyper-V 虚拟机管理助手">
    </Installer>
    <PackageInformation
        PackageName="Hyper-V 虚拟机管理助手"
        PackageDisplayName="Hyper-V 虚拟机管理助手"
        PublisherName="CN=Local"
        PublisherDisplayName="Local"
        Version="0.1.0.0"
        PackageDescription="Hyper-V 虚拟机可视化管理工具">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.local.hypervvmmanager"
                Description="Hyper-V 虚拟机可视化管理工具"
                DisplayName="Hyper-V 虚拟机管理助手"
                ExecutableName="hyperv-vmmanager.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hyper-V 虚拟机管理助手</DisplayName>
            <PublisherDisplayName>Local</PublisherDisplayName>
            <Description>Hyper-V 虚拟机可视化管理工具</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hyperv-vmmanager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
